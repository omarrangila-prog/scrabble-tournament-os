# Firebase — optional.
#
# The app runs fully without these, storing data in the browser. Fill them in
# to switch every screen onto a real Firestore project; no code changes are
# needed, and a partially filled file is treated as unconfigured rather than
# half-connecting and failing later.
#
# Copy to .env.local and paste the values from:
#   Firebase console -> Project settings -> Your apps -> SDK setup and config

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only if Google Analytics is enabled on the project.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Supabase — an alternative backend to Firebase. Either may be configured;
# Supabase takes precedence when both are present.
NEXT_PUBLIC_SUPABASE_URL=
# Either name works. A project created after Supabase renamed the anon key gives
# you the publishable one; an older project gives you the anon one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email. Without these, nothing is sent and every screen says so rather than
# pretending — a confirmation nobody received is worse than one that visibly failed.
# The key is server-side only and must never be prefixed NEXT_PUBLIC_.
RESEND_API_KEY=
# Must be an address on a domain verified with the provider. An unverified sender is
# the most common reason a send is refused.
EMAIL_FROM=

# The database connection, used only by scripts/apply-migrations.sh. Never read by
# the app, and never sent to a browser.
#
#   Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
#
# The direct host resolves to IPv6 only. On a network without IPv6 routing it fails
# with "Network is unreachable", so set the pooler URL as well and the script will
# prefer it: Connection pooling -> Session mode, host aws-0-<region>.pooler.supabase.com,
# user postgres.<project-ref>.
SUPABASE_DB_URL=
SUPABASE_DB_POOLER_URL=
