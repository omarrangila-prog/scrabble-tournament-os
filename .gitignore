# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python bytecode from the import scripts.
__pycache__/
*.pyc

# Participant contact exports. Real names, mobiles and email addresses —
# this repository is public, so these never get committed.
contacts/
*.vcf
*.xlsx
exports/

# Matched participant addresses for the results mailing. Real emails — same rule as
# the contact exports above: generated on demand, never committed.
scripts/data/
